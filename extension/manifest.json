{
  "manifest_version": 3,
  "name": "ContextSync",
  "version": "1.0.0",
  "description": "Bridges your local terminal workflow with ChatGPT and Claude — no cloud APIs required.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ContextSync"
  }
}
